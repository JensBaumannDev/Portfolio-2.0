# --- SPA-Routing (Angular) ---
# Vorhandene Dateien/Ordner direkt ausliefern, alles andere an index.html,
# damit Reloads auf Routen wie /cv oder /legal-notice nicht 404 liefern.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

# --- Caching ---
<IfModule mod_headers.c>
  # index.html und Übersetzungen (i18n) tragen keinen Hash im Namen -> immer
  # revalidieren, sonst sehen wiederkehrende Besucher veraltete Texte/Keys.
  <FilesMatch "(index\.html|\.json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Gehashte Build-Assets (Angular haengt Content-Hashes an) -> unveraenderlich.
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Fonts aendern sich praktisch nie -> ein Jahr, unveraenderlich.
  <FilesMatch "\.(woff2?|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Ungehashte Bilder -> 30 Tage. Laenger nur, wenn beim Austausch der Dateiname
  # (oder ein ?v=-Suffix) mitgeaendert wird, sonst sehen Besucher das alte Bild.
  <FilesMatch "\.(png|jpe?g|webp|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
