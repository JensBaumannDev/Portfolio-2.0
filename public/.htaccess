# --- SPA-Routing (Angular) ---
# Vorhandene Dateien/Ordner direkt ausliefern, alles andere an index.html,
# damit Reloads auf Routen wie /cv oder /legal-notice nicht 404 liefern.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

# --- Caching ---
<IfModule mod_headers.c>
  # index.html und Übersetzungen (i18n) tragen keinen Hash im Namen -> immer
  # revalidieren, sonst sehen wiederkehrende Besucher veraltete Texte/Keys.
  <FilesMatch "(index\.html|\.json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Gehashte Build-Assets (Angular haengt Content-Hashes an) -> unveraenderlich.
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Ungehashte Bilder/Fonts -> kurz cachen (1 Tag).
  <FilesMatch "\.(png|jpe?g|webp|gif|svg|ico|woff2?|ttf|eot)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
